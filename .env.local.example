# ProgramCreator environment variables
# Copy to .env.local and fill in real values.
# Share your Google Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.

# --- Supabase ---
# Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Sheets ---
# Google Cloud Console → create service account → enable Sheets API → download JSON
# Paste the client_email and private_key below. Escape newlines as \n in the private key.
# Create a Sheet with a tab named "Leads", share it with the service account as Editor.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=your-spreadsheet-id

# --- Resend ---
# resend.com → API Keys. Verify a sending domain before production.
# RESEND_API_KEY=re_xxx
# Inbox that receives new-lead notifications (your personal inbox is fine).
# LEAD_NOTIFY_EMAIL=you@example.com

# --- Cal.com / site ---
# NEXT_PUBLIC_CAL_LINK=daivescales/discovery
# NEXT_PUBLIC_SITE_URL=https://programcreator.com
# Shared secret for /api/cal-webhook (warn-only in check-env if missing locally)
# CAL_WEBHOOK_SECRET=generate-a-long-random-string
